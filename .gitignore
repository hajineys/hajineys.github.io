# Bundler cache
.bundle
vendor
Gemfile.lock

# Jekyll cache
.jekyll-cache
.jekyll-metadata
_site

# RubyGems
*.gem

# NPM dependencies
node_modules
package-lock.json

# IDE configurations
.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# Misc
_sass/vendors
assets/js/dist/*
# except our hand-written override that shadows the theme's sw.min.js
# to force a byte change (and thus a real update check) on every build
!assets/js/dist/sw.min.js

# Hidden system files
*~
.DS_Store
Thumbs.db
